cd domains/digicomvn.com/public_html && wp post meta update 7774 dgc_seo_title "Influencer Là Gì? Phân Loại Và Influencer Marketing" --allow-root && wp post meta update 7774 dgc_seo_desc "Influencer là gì? Nghĩa và gốc từ, phân loại nano, micro, macro, mega, khác KOL, KOC, 5 bước làm influencer marketing và nghĩa vụ ghi nhãn quảng cáo 2026." --allow-root && wp post meta update 7769 _wp_attachment_image_alt "Thang phân loại influencer theo quy mô người theo dõi: nano dưới 10.000, micro 10.000 đến 100.000, macro 100.000 đến 1 triệu, mega trên 1 triệu, kèm các ngưỡng khác mà một số nguồn dùng" --allow-root && wp post update 7769 --post_parent=7774 --allow-root && wp post meta update 7768 _wp_attachment_image_alt "Quy trình influencer marketing 5 bước: chốt mục tiêu và ngân sách, chọn và thẩm định influencer, viết brief và ký hợp đồng, triển khai và duyệt nội dung, đo lường và tổng kết" --allow-root && wp post update 7768 --post_parent=7774 --allow-root
